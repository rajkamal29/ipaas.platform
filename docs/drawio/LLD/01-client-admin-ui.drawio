        <mxCell id="title" value="LLD — Client &amp; Admin UI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#8A5FB3;strokeColor=#5B3D80;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="20" width="700" height="50" as="geometry" /></mxCell>
        <mxCell id="tech" value="Tech stack: Angular, TypeScript, RxJS, Angular Material, REST/HTTPS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1E2761;strokeColor=#1E2761;fontColor=#CADCFC;fontStyle=2;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="100" y="90" width="700" height="46" as="geometry" /></mxCell>
        <mxCell id="s0" value="1. User authenticates (login) via API Layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF1FB;strokeColor=#2E5395;fontColor=#1F3864;fontStyle=1;fontSize=12.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="140" y="166" width="620" height="60" as="geometry" /></mxCell>
        <mxCell id="s1" value="2. Load valid connectors, supported entities &amp; auth types from API metadata endpoints" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF1FB;strokeColor=#2E5395;fontColor=#1F3864;fontStyle=1;fontSize=12.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="140" y="260" width="620" height="60" as="geometry" /></mxCell>
        <mxCell id="s2" value="3. Select source, target, sync mode, canonical entity — only valid combinations shown" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF1FB;strokeColor=#2E5395;fontColor=#1F3864;fontStyle=1;fontSize=12.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="140" y="354" width="620" height="60" as="geometry" /></mxCell>
        <mxCell id="s3" value="4. Dynamic credential form rendered per provider auth type" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF1FB;strokeColor=#2E5395;fontColor=#1F3864;fontStyle=1;fontSize=12.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="140" y="448" width="620" height="60" as="geometry" /></mxCell>
        <mxCell id="s4" value="5. &quot;Test Connection&quot; calls API → Connector &amp; Auth Layer authenticate()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF1FB;strokeColor=#2E5395;fontColor=#1F3864;fontStyle=1;fontSize=12.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="140" y="542" width="620" height="60" as="geometry" /></mxCell>
        <mxCell id="s5" value="6. Build/edit canonical mapping (field picker + dry-run preview)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF1FB;strokeColor=#2E5395;fontColor=#1F3864;fontStyle=1;fontSize=12.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="140" y="636" width="620" height="60" as="geometry" /></mxCell>
