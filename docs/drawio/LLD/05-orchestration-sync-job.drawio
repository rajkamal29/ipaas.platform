        <mxCell id="title" value="LLD — Orchestration / Sync Job (runSync)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#8A5FB3;strokeColor=#5B3D80;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="20" width="700" height="50" as="geometry" /></mxCell>
        <mxCell id="tech" value="Tech stack: Node.js, connector-sdk, pino" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1E2761;strokeColor=#1E2761;fontColor=#CADCFC;fontStyle=2;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="100" y="90" width="700" height="46" as="geometry" /></mxCell>
        <mxCell id="s0" value="1. Container starts — fetches secrets via service token" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF1FB;strokeColor=#2E5395;fontColor=#1F3864;fontStyle=1;fontSize=12.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="140" y="166" width="620" height="60" as="geometry" /></mxCell>
        <mxCell id="s1" value="2. Read enabled-entities list (e.g. Client, Project, Timesheet)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF1FB;strokeColor=#2E5395;fontColor=#1F3864;fontStyle=1;fontSize=12.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="140" y="260" width="620" height="60" as="geometry" /></mxCell>
        <mxCell id="s2" value="3. For each entity: load its own checkpoint, fetch/map/persist/write (retry)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF1FB;strokeColor=#2E5395;fontColor=#1F3864;fontStyle=1;fontSize=12.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="140" y="354" width="620" height="60" as="geometry" /></mxCell>
        <mxCell id="s3" value="4. One entity's failure is caught and logged — others in this run continue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF1FB;strokeColor=#2E5395;fontColor=#1F3864;fontStyle=1;fontSize=12.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="140" y="448" width="620" height="60" as="geometry" /></mxCell>
        <mxCell id="s4" value="5. Checkpoint saved after every page, per entity" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF1FB;strokeColor=#2E5395;fontColor=#1F3864;fontStyle=1;fontSize=12.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="140" y="542" width="620" height="60" as="geometry" /></mxCell>
        <mxCell id="s5" value="6. Record per-entity result (success/failed) at run end" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF1FB;strokeColor=#2E5395;fontColor=#1F3864;fontStyle=1;fontSize=12.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="140" y="636" width="620" height="60" as="geometry" /></mxCell>
        <mxCell id="s6" value="7. Log run summary and exit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF1FB;strokeColor=#2E5395;fontColor=#1F3864;fontStyle=1;fontSize=12.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="140" y="730" width="620" height="60" as="geometry" /></mxCell>
