        <mxCell id="s2" value="3. Run tests / lint" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF1FB;strokeColor=#2E5395;fontColor=#1F3864;fontStyle=1;fontSize=12.5;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="140" y="354" width="620" height="60" as="geometry" /></mxCell>
