# Non-secret local configuration examples.
LOG_LEVEL=info
STATUS_LOG_INTERVAL_MS=60000

# Same shared database configured in ../ipaas.infra/.env.
POSTGRES_PASSWORD=changeme_local_only
DATABASE_URL=postgres://ipaas:changeme_local_only@localhost:5432/ipaas_platform

# Passed to Orchestration Engine containers; use the same key configured there.
# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# JSON array of approved source/destination runtime image mappings.
RUNTIME_IMAGE_MAPPINGS_JSON=[{"sourceConnector":"workday","destinationConnector":"keka","registry":"GHCR","repository":"tezo/workday-keka-runtime","tag":"1.0.0"},{"sourceConnector":"bamboohr","destinationConnector":"keka","registry":"DockerHub","repository":"tezo/bamboohr-keka-runtime","tag":"1.0.0"}]

# Docker Desktop on Windows. Linux/macOS defaults to /var/run/docker.sock.
DOCKER_SOCKET_PATH=//./pipe/docker_engine

# GitHub Actions workflow dispatch. Set GITHUB_TOKEN separately; never commit it.
GITHUB_ACTIONS_API_BASE_URL=https://api.github.com
GITHUB_ACTIONS_OWNER=kunal-tezo
GITHUB_ACTIONS_REPOSITORY=ipaas-provisioning-engine
GITHUB_ACTIONS_WORKFLOW=provision-runtime.yml
GITHUB_ACTIONS_REF=main-node

# Opt-in live workflow verification.
RUN_GITHUB_INTEGRATION_TESTS=false
GITHUB_INTEGRATION_TEST_IMAGE=hello-world:latest

