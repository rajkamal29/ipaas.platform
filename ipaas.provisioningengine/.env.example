# Configuration is read centrally from the process environment.
# Node supports: node --env-file=.env dist/index.js
LOG_LEVEL=info
DATABASE_URL=postgres://ipaas:<password>@localhost:5432/ipaas_platform
# Same database, using an address reachable from the runtime container.
RUNTIME_DATABASE_URL=postgres://ipaas:<password>@ipaas-postgres:5432/ipaas_platform
# Set the same base64 32-byte key used by orchestration; never commit it.
ENCRYPTION_MASTER_KEY=
RUNTIME_PROVIDER=docker
DOCKER_NETWORK=ipaas-network
RUNTIME_TIMEOUT_MS=120000
# Optional override; platform socket is selected automatically if absent.
# DOCKER_SOCKET_PATH=//./pipe/docker_engine
# Pin an approved immutable image version for deployment.
RUNTIME_IMAGE_MAPPINGS_JSON=[{"source":"connectwise","target":"keka","registry":"GHCR","repository":"rajkamal29/ipaas-orchestration-engine","tag":"<approved-version>"}]
# Optional explicit work item. #18 never discovers or claims submitted rows.
SYNC_ENTITY_ID=
# Required only when RUNTIME_PROVIDER=github:
GITHUB_ACTIONS_API_BASE_URL=https://api.github.com
GITHUB_ACTIONS_OWNER=rajkamal29
GITHUB_ACTIONS_REPOSITORY=ipaas.platform
GITHUB_ACTIONS_WORKFLOW=provision-runtime.yml
GITHUB_ACTIONS_REF=dev
GITHUB_TOKEN=
RUN_LIVE_VERIFICATION=false
