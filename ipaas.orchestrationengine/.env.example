# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Postgres itself — the container, its init scripts, and schema migrations —
# now lives in the sibling ipaas.infra folder (2026-09-08 split), with its
# own .env. This app only needs to know where to connect; keep the value
# below in sync with ipaas.infra/.env's POSTGRES_USER/PASSWORD/DB.
DATABASE_URL=postgres://ipaas:changeme_local_only@localhost:5432/ipaas_platform

# AES-256-GCM key for encrypting the `credentials` table (lib/crypto.js).
# Must be a base64-encoded 32-byte key — generate one with:
#   openssl rand -base64 32
# Losing/changing this makes every existing encrypted credentials row
# undecryptable — treat it like a real secret, not a placeholder.
ENCRYPTION_MASTER_KEY=

# Structured logging (lib/logger.js, pino). One of: trace, debug, info, warn,
# error, fatal. debug shows per-page/per-record detail; info (default) is
# the run-lifecycle level.
LOG_LEVEL=info

# Set to "production" to disable the pino-pretty console transport (used
# by the Docker image; leave unset for local dev so logs stay readable).
NODE_ENV=
