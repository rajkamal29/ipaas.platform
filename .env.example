# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

POSTGRES_USER=ipaas
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=ipaas_platform

# Used by node-pg-migrate and the app to connect to the ipaas_platform database
DATABASE_URL=postgres://ipaas:changeme_local_only@localhost:5432/ipaas_platform

# AES-256-GCM key for encrypting the `credentials` table (lib/crypto.js).
# Must be a base64-encoded 32-byte key — generate one with:
#   openssl rand -base64 32
# Losing/changing this makes every existing encrypted credentials row
# undecryptable — treat it like a real secret, not a placeholder.
ENCRYPTION_MASTER_KEY=

# Structured logging (lib/logger.js, pino). One of: trace, debug, info, warn,
# error, fatal. debug shows per-page/per-record detail; info (default) is
# the run-lifecycle level.
LOG_LEVEL=info

# Set to "production" to disable the pino-pretty console transport (used
# by the Docker image; leave unset for local dev so logs stay readable).
NODE_ENV=

# Orchestration Engine entrypoint input (lib/orchestration/run.js) — scopes
# one run to exactly one sync_requests row; everything else (tenant,
# source/target, entities, credentials, mapping) loads from Postgres using
# this ID. Not a fixed value — set it per run/demo, e.g.:
#   $env:SYNC_REQUEST_ID="<uuid>"; node lib/orchestration/run.js   (PowerShell)
# Left blank here since it changes constantly; see docs/DEMO-orchestration-engine.md.
SYNC_REQUEST_ID=
