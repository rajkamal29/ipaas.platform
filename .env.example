# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

POSTGRES_USER=ipaas
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=ipaas_platform

# Used by node-pg-migrate and the app to connect to the ipaas_platform database
DATABASE_URL=postgres://ipaas:changeme_local_only@localhost:5432/ipaas_platform

# Custom orchestration (lib/orchestration/) — Day 4, no Temporal.
# TENANT_ID: the OculusIT tenant's uuid — SELECT id FROM tenants WHERE name = 'OculusIT';
TENANT_ID=
# Cron cadence for scripts/schedule-client-sync.js (default: every 15 minutes)
SYNC_CRON_SCHEDULE=*/15 * * * *

# Structured logging (lib/logger.js, pino). One of: trace, debug, info, warn,
# error, fatal. debug shows per-page/per-record detail; info (default) is
# the run-lifecycle level suitable for the Day 5 Loki/Grafana pipeline.
LOG_LEVEL=info
