# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#
# This controls the local Postgres container (docker-compose.yml) and the
# schema migrations (migrations/) that run against it — nothing else lives
# here. Whichever engine actually connects at runtime (ipaas.orchestrationengine
# today) keeps its own DATABASE_URL in its own .env; keep both in sync
# whenever you change the values below.

POSTGRES_USER=ipaas
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=ipaas_platform

# Used by node-pg-migrate (npm run migrate:up/down/create) to connect and
# apply schema changes. Must match the three vars above.
DATABASE_URL=postgres://ipaas:changeme_local_only@localhost:5432/ipaas_platform
